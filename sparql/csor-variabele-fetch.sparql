# ============================================================================
# Paginatie-CONSTRUCT-template voor de codelijst-csor-variabele-graph.
#
# AANLEIDING: de endpoint (https://data-ontwikkel.omgeving.vlaanderen.be/sparql) knipt
# CONSTRUCT-resultaten stil af op 10.000 triples, zonder foutmelding. De variabele-graph
# telt 25.312 triples (bevestigd via query 0 hieronder) — een niet-gepagineerde CONSTRUCT
# zou dus stilzwijgend maar 10.000 van de 25.312 triples teruggeven.
#
# VALIDATIE: drie pagina's van 10.000 + 10.000 + 5.312 triples (query 1, OFFSET 0/10000/20000)
# telden empirisch exact op tot de 25.312 van query 0. GEEN ORDER BY toevoegen aan query 1 —
# dat gaf een HTTP 500 op deze endpoint. Zonder ORDER BY bleken de pagina's stabiel en
# niet-overlappend over herhaalde runs.
#
# Dit bestand documenteert de aanpak; de effectieve paginatie (OFFSET ophogen tot een pagina
# < 10.000 triples teruggeeft) gebeurt in scripts/common/sparql_client.py::fetch_graph().
# ============================================================================

PREFIX csor: <https://data.omgeving.vlaanderen.be/ns/csor#>

# ----------------------------------------------------------------------------
# QUERY 0 — Onafhankelijke referentiewaarde: totaal aantal triples in de graph.
# Elke paginatie-fetch moet hier exact tegen optellen (zie fetch_graph()'s verify=True).
# ----------------------------------------------------------------------------
SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH <https://data.omgeving.vlaanderen.be/id/graph/codelijst-csor-variabele> { ?s ?p ?o }
}


# ----------------------------------------------------------------------------
# QUERY 1 — Paginatie-template. Herhaal met OFFSET 0, 10000, 20000, ... tot een pagina
# minder dan LIMIT triples teruggeeft. GEEN ORDER BY.
# ----------------------------------------------------------------------------
CONSTRUCT {?s ?p ?o}
WHERE {
  GRAPH <https://data.omgeving.vlaanderen.be/id/graph/codelijst-csor-variabele> { ?s ?p ?o }
}
LIMIT 10000 OFFSET 0
